# Your Anthropic API key (the server uses this to run every analysis).
# Optional if you'd rather not manage a key at all - see "Running without an
# API key" in the README for the `ant auth login` alternative.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for analysis
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: max characters of source text sent to the model per request
# (guards against blowing the context window on very long PDFs)
MAX_SOURCE_CHARS=180000

# Optional: port for the local server
PORT=8000

# Note: Zotero API keys are NOT set here. Each user enters their own
# Zotero API key and library ID in the web UI, and it is only ever
# used to make requests on their behalf for that request - it is not
# persisted to disk by the server.
